server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # React SPA
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html references hashed bundles, so it must be revalidated on every
    # load; otherwise browsers/proxies keep serving the old hashes after a deploy.
    # SPA fallbacks from try_files above are internally redirected here too.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    # Vite emits content-hashed filenames under /assets/, safe to cache forever.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # REST API
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Resumable (tus) uploads: stream chunks straight through instead of
    # buffering each request body to disk first.
    location /api/v1/uploads/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public WebSocket (read-only, optional auth)
    location /ws/public/ {
        proxy_pass http://${COLLAB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Public-Access "true";
        proxy_read_timeout 3600s;
    }

    # Authenticated WebSocket
    location /ws/ {
        proxy_pass http://${COLLAB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Public-Access "false";
        proxy_read_timeout 3600s;
    }

    # Channel messaging (Socket.IO)
    location /socket.io/ {
        proxy_pass http://${MESSAGING_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
    }
}
