# Copy to .env in the repo root: `cp .env.example .env`. docker-compose.yml
# loads this file into every service, so all configuration lives here.

# Application Settings
# Required: a long random string (e.g. `openssl rand -hex 32`). It signs the
# session JWT shared by notomate-api, notomate-collab and notomate-messaging.
APP_SECRET=
APP_DISABLE_SIGNUP=
# Public URL of this instance, e.g. https://notes.example.com. Required behind a
# proxy or tunnel for MCP clients: it is the OAuth issuer and the MCP resource.
APP_PUBLIC_URL=

# Service Addresses
# Container names from docker-compose.yml; leave as-is unless you rename them.
MESSAGING_ADDR=http://notomate-messaging:4000
GRPC_ADDR=notomate-api:50051
API_URL=http://notomate-api:8080
COLLAB_URL=ws://notomate-collab:3000

# Database Configuration
# The bundled notomate-mysql container. Change both passwords before
# deploying, and use the same MYSQL_PASSWORD inside DB_DSN.
MYSQL_DATABASE=notomate
MYSQL_USER=notomate
MYSQL_PASSWORD=notomate_password
MYSQL_ROOT_PASSWORD=notomate_root_password
DB_DRIVER=mysql
DB_DSN=notomate:notomate_password@tcp(notomate-mysql:3306)/notomate?charset=utf8mb4

# Or use another database instead:
# PostgreSQL:
# DB_DRIVER=postgres
# DB_DSN=host=your-postgres-host port=5432 user=notomate password=notomate_password dbname=notomate sslmode=disable TimeZone=UTC
# SQLite (stored in ./bin):
# DB_DRIVER=sqlite3
# DB_DSN=/usr/local/app/bin/notomate.db

# Storage Configuration (S3/MinIO)
# Leave commented to use default local file storage
# STORAGE_TYPE=s3
# STORAGE_S3_ENDPOINT=localhost:9000
# STORAGE_S3_ACCESS_KEY=minioadmin
# STORAGE_S3_SECRET_KEY=minioadmin
# STORAGE_S3_BUCKET=notomate
# STORAGE_S3_USE_SSL=false

# AWS S3 Example
# STORAGE_TYPE=s3
# STORAGE_S3_ENDPOINT=s3.amazonaws.com
# STORAGE_S3_ACCESS_KEY=your_aws_access_key
# STORAGE_S3_SECRET_KEY=your_aws_secret_key
# STORAGE_S3_BUCKET=your-bucket-name
# STORAGE_S3_USE_SSL=true

# Workflow Runner
# Shared registration token for notomate-api and notomate-runner
# RUNNER_REGISTRATION_TOKEN=change-me

# gRPC address the runner (docker-compose.runner.yml) uses to reach the api.
# Defaults to host.docker.internal:50051 (api's published gRPC port on the
# same host). Set to a remote host:port if the runner runs elsewhere.
# NM_INSTANCE_ADDR=host.docker.internal:50051
